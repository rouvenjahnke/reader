# Read-only PostgreSQL connection used by scripts/debug-terence-tao.mjs.
# Prefer a dedicated role with SELECT permission only.
DATABASE_URL=postgresql://reader_debug:password@postgres-host:5432/math_corpus

# Optional. If omitted, the script reads the Miniflux URL/token from the local,
# gitignored Pipeline_Math_AI_Blogs (6).json workflow export.
MINIFLUX_URL=https://miniflux.example.com
MINIFLUX_TOKEN=replace-me

# Optional but recommended: verify the workflow version currently active in n8n
# and locate executions containing the selected Miniflux entry ID or URL.
N8N_URL=https://n8n.example.com
N8N_API_KEY=replace-me
# N8N_WORKFLOW_ID=optional-explicit-id

# Optional Reader API check. Start `npm run dev` before the diagnostic when
# using localhost. READER_AUTH_TOKEN is reused from .env when configured.
READER_URL=http://localhost:3000

# Existing NEXTCLOUD_* values from .env are used for the WebDAV check.
