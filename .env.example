# Nextcloud WebDAV — server-side only, never exposed to the frontend.
NEXTCLOUD_URL=https://nextcloud.example.com/remote.php/dav/files/<user>
NEXTCLOUD_USERNAME=<user>
NEXTCLOUD_APP_PASSWORD=<app-password>

# Pipeline folder with the daily articles.
NEXTCLOUD_BASE_PATH=/Workstation/Projects/maths/00_inbox/reader-pipeline/

# Optional: second folder with starred arXiv papers. When set, its markdown
# files appear in the app tagged as »paper« (visibility configurable under
# Settings → Papers folder). Leave unset to disable.
# NEXTCLOUD_PAPERS_PATH=/Workstation/Projects/maths/00_inbox/papers/
